# ==============================================
# LLM API KEYS (Choose one or both)
# ==============================================

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default LLM Provider (options: "openai" or "anthropic")
DEFAULT_LLM_PROVIDER=openai

# ==============================================
# SOCIAL MEDIA MANAGER MCP TOOL CONFIGURATION
# ==============================================
# Note: The Social Media Manager extension handles authentication
# through VSCode. No additional API keys needed here unless you're
# using direct API integration.

# Optional: If using direct API integration (not MCP)
# FACEBOOK_ACCESS_TOKEN=your_facebook_token
# TWITTER_API_KEY=your_twitter_api_key
# TWITTER_API_SECRET=your_twitter_api_secret
# TWITTER_ACCESS_TOKEN=your_twitter_access_token
# TWITTER_ACCESS_SECRET=your_twitter_access_secret
# LINKEDIN_ACCESS_TOKEN=your_linkedin_token
# INSTAGRAM_ACCESS_TOKEN=your_instagram_token

# ==============================================
# APPLICATION SETTINGS
# ==============================================

# Default Character Limits (can be overridden in code)
LINKEDIN_CHAR_LIMIT=3000
TWITTER_CHAR_LIMIT=280
INSTAGRAM_CHAR_LIMIT=2200
FACEBOOK_CHAR_LIMIT=63206

# Timezone for Scheduling (e.g., "America/New_York", "UTC")
TIMEZONE=UTC
